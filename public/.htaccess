# ====================================================================
# My Cat PWA — Hostinger Apache / LiteSpeed Production Configuration
# ====================================================================

# 1. Enable Rewrite Engine for Single Page Application (SPA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS redirection without reverse-proxy redirect loops
  # Supports native Hostinger SSL and reverse-proxy setups (Cloudflare, LiteSpeed)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Do not rewrite real existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all other requests to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# 2. MIME Types for PWA and Web Audio
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/manifest+json .json
  AddType image/svg+xml .svg
  AddType audio/mpeg .mp3
  AddType audio/wav .wav
  AddType audio/ogg .ogg
  AddType font/woff2 .woff2
</IfModule>

# 3. HTTP Caching Headers (Non-overlapping, Order-Safe)
<IfModule mod_headers.c>
  # A. Bundled Static Audio and Image Assets — Cache for 30 Days
  <FilesMatch "\.(mp3|wav|ogg|png|jpg|jpeg|gif|ico|svg|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # B. Hashed Production Build Assets — Cache for 1 Year (Immutable)
  # Strictly targets fingerprinted files generated by Vite (e.g., assets/*-XYZ123.js/css)
  # Does NOT match sw.js, registerSW.js, or root scripts
  <FilesMatch "^.+-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # C. PWA Control Files & Entrypoint — NEVER CACHE AGGRESSIVELY
  # Must always revalidate to ensure users receive immediate app updates
  # Placed last with 'Header set' to guarantee precedence over any generic rule
  <FilesMatch "(index\.html|sw\.js|registerSW\.js|workbox-[A-Za-z0-9_-]+\.js|manifest\.webmanifest|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # D. Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Gzip / Deflate Compression for Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# 5. Disable Directory Browsing
Options -Indexes
